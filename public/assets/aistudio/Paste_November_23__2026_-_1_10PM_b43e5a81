2. Lead Intake Form + Loading State (components/LeadIntakeForm.tsx)
AI qualification mein kuch seconds lagte hain, is liye submit ke waqt clear loading spinner/message aur 400 validation error handling di gayi hai.

TypeScript
"use client";

import React, { useState } from "react";
import {
  API_BASE_URL,
  IntakeFormValues,
  Lead,
  mapFormToLeadPayload,
} from "@/types/lead";

interface LeadIntakeFormProps {
  onLeadScored: (lead: Lead) => void;
  useMockFallback?: boolean;
}

const INITIAL_FORM: IntakeFormValues = {
  fullName: "",
  email: "",
  phone: "",
  company: "",
  serviceNeeded: "",
  projectNotes: "",
  monthlyBudget: "",
  timeline: "",
};

export default function LeadIntakeForm({
  onLeadScored,
  useMockFallback = false,
}: LeadIntakeFormProps) {
  const [form, setForm] = useState<IntakeFormValues>(INITIAL_FORM);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  const handleChange = (
    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>
  ) => {
    const { name, value } = e.target;
    setForm((prev) => ({ ...prev, [name]: value }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMsg(null);

    const payload = mapFormToLeadPayload(form);

    // Backend requires at least one of email, phone, or message (400 otherwise)
    if (!payload.email && !payload.phone && !payload.message) {
      setErrorMsg("Please provide at least an email, phone number, or project message.");
      return;
    }

    setIsSubmitting(true);
    try {
      if (useMockFallback) {
        await new Promise((r) => setTimeout(r, 900));
        const mockScored: Lead = {
          id: Date.now(),
          source: "form",
          name: payload.name || "Demo Lead",
          email: payload.email,
          company: payload.company || "Independent",
          need: payload.message,
          budget: payload.budget || "Not specified",
          timeline: payload.timeline || "Flexible",
          score: 72,
          tier: "hot",
          summary: `Qualified inbound inquiry from ${payload.company || payload.name} regarding ${payload.message}.`,
          next_step: "Send tailored proposal and book a qualification call",
          email_subject: `Your project: ${form.serviceNeeded || "Inquiry"}`,
          email_body: `Hi ${payload.name || "there"}, thanks for reaching out...`,
          status: "new",
          qualified: 1,
          created: Math.floor(Date.now() / 1000),
          updated: Math.floor(Date.now() / 1000),
        };
        onLeadScored(mockScored);
        setForm(INITIAL_FORM);
        return;
      }

      const res = await fetch(`${API_BASE_URL}/api/leads`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setErrorMsg(data?.detail || `Request failed with status ${res.status}`);
        return;
      }

      onLeadScored(data as Lead);
      setForm(INITIAL_FORM);
    } catch {
      setErrorMsg("Could not reach LeadPilot backend at http://127.0.0.1:8002.");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <form
      onSubmit={handleSubmit}
      className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-4"
    >
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-lg font-semibold text-slate-900">New Lead Intake</h2>
          <p className="text-xs text-slate-500">
            Demo mode — avoid entering real client data.
          </p>
        </div>
        <span className="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          POST /api/leads
        </span>
      </div>

      {errorMsg && (
        <div className="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          {errorMsg}
        </div>
      )}

      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Full Name
          </label>
          <input
            type="text"
            name="fullName"
            value={form.fullName}
            onChange={handleChange}
            placeholder="Priya Nair"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Email
          </label>
          <input
            type="email"
            name="email"
            value={form.email}
            onChange={handleChange}
            placeholder="priya.nair@lumenskin.co"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Company
          </label>
          <input
            type="text"
            name="company"
            value={form.company}
            onChange={handleChange}
            placeholder="Lumen Skin"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Phone (optional)
          </label>
          <input
            type="text"
            name="phone"
            value={form.phone}
            onChange={handleChange}
            placeholder="+92 300 0000000"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Monthly Budget
          </label>
          <input
            type="text"
            name="monthlyBudget"
            value={form.monthlyBudget}
            onChange={handleChange}
            placeholder="$800 per month"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-slate-700 mb-1">
            Timeline
          </label>
          <input
            type="text"
            name="timeline"
            value={form.timeline}
            onChange={handleChange}
            placeholder="Next quarter"
            className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label className="block text-xs font-medium text-slate-700 mb-1">
          Service Needed
        </label>
        <input
          type="text"
          name="serviceNeeded"
          value={form.serviceNeeded}
          onChange={handleChange}
          placeholder="Social media management / Web app"
          className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
        />
      </div>

      <div>
        <label className="block text-xs font-medium text-slate-700 mb-1">
          Project Notes
        </label>
        <textarea
          name="projectNotes"
          rows={3}
          value={form.projectNotes}
          onChange={handleChange}
          placeholder="Describe goals, scope, or inquiry context..."
          className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
        />
      </div>

      <button
        type="submit"
        disabled={isSubmitting}
        className="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60 flex items-center justify-center gap-2 transition"
      >
        {isSubmitting ? (
          <>
            <span className="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" />
            <span>Qualifying lead with AI (takes a few seconds)...</span>
          </>
        ) : (
          <span>Qualify Lead</span>
        )}
      </button>
    </form>
  );
}
