        </div>

        <div className="flex flex-wrap gap-2 text-xs font-medium">
          <span className="rounded-md bg-slate-100 px-2.5 py-1 text-slate-700">
            Total: {stats.total}
          </span>
          <span className="rounded-md bg-emerald-50 px-2.5 py-1 text-emerald-700">
            Hot: {stats.hot}
          </span>
          <span className="rounded-md bg-amber-50 px-2.5 py-1 text-amber-700">
            Warm: {stats.warm}
          </span>
          <span className="rounded-md bg-sky-50 px-2.5 py-1 text-sky-700">
            Cold: {stats.cold}
          </span>
          <span className="rounded-md bg-indigo-50 px-2.5 py-1 text-indigo-700">
            New: {stats.new}
          </span>
          <span className="rounded-md bg-purple-50 px-2.5 py-1 text-purple-700">
            Won: {stats.won}
          </span>
        </div>
      </div>

      {/* Tier Filter + Client Search */}
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="inline-flex rounded-lg border border-slate-200 bg-slate-50 p-1 text-xs font-medium">
          {(["all", "hot", "warm", "cold"] as const).map((tier) => (
            <button
              key={tier}
              type="button"
              onClick={() => onTierChange(tier)}
              className={`rounded-md px-3 py-1.5 capitalize transition ${
                activeTier === tier
                  ? "bg-white text-slate-900 shadow-xs"
                  : "text-slate-600 hover:text-slate-900"
              }`}
            >
              {tier}
            </button>
          ))}
        </div>

        <input
          type="text"
          value={searchQuery}
