"use client";

import React from "react";
import { Lead, LeadTier } from "@/types/lead";

interface QualificationResultCardProps {
  lead: Lead | null;
  aiError?: string | null;
  onRetryRequalify?: (leadId: number) => void;
  onOpenDrawer?: (leadId: number) => void;
  isRequalifying?: boolean;
}

const TIER_STYLES: Record<LeadTier, { badge: string; bar: string; label: string }> = {
  hot: {
    badge: "bg-emerald-100 text-emerald-800 border-emerald-200",
    bar: "bg-emerald-500",
    label: "HOT (70+)",
  },
  warm: {
    badge: "bg-amber-100 text-amber-800 border-amber-200",
    bar: "bg-amber-500",
    label: "WARM (40–69)",
  },
  cold: {
    badge: "bg-sky-100 text-sky-800 border-sky-200",
    bar: "bg-sky-500",
    label: "COLD (<40)",
  },
};

export default function QualificationResultCard({
  lead,
  aiError,
  onRetryRequalify,
  onOpenDrawer,
  isRequalifying = false,
}: QualificationResultCardProps) {
  if (aiError && lead) {
    return (
      <div className="rounded-xl border border-rose-200 bg-rose-50 p-5 space-y-3">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-rose-900">
            AI Qualification Temporarily Failed
          </h3>
          <span className="text-xs font-medium text-rose-700">502</span>
        </div>
        <p className="text-sm text-rose-800">{aiError}</p>
        {onRetryRequalify && (
          <button
            type="button"
            onClick={() => onRetryRequalify(lead.id)}
            disabled={isRequalifying}
            className="rounded-lg bg-rose-600 px-3.5 py-2 text-xs font-medium text-white hover:bg-rose-700 disabled:opacity-60"
          >
            {isRequalifying ? "Retrying..." : "Retry Qualification"}
          </button>
        )}
      </div>
    );
  }

  if (!lead) {
    return (
      <div className="rounded-xl border border-dashed border-slate-300 bg-slate-50/70 p-6 text-center">
        <p className="text-sm font-medium text-slate-700">No Lead Scored Yet</p>
        <p className="mt-1 text-xs text-slate-500">
          Submit the intake form to view score, tier, summary, and recommended next step.
        </p>
      </div>
    );
  }

  const style = TIER_STYLES[lead.tier];
  const clampedScore = Math.max(0, Math.min(100, lead.score));

  return (
    <div className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p className="text-xs font-medium uppercase tracking-wide text-slate-400">
            Qualification Result
          </p>
          <h3 className="text-lg font-semibold text-slate-900">
            {lead.name}{" "}
            {lead.company && (
              <span className="text-sm font-normal text-slate-500">
                · {lead.company}
              </span>
            )}
          </h3>
        </div>

        <span
          className={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold ${style.badge}`}
        >
          {style.label}
        </span>
      </div>

      {/* Score Meter (0 to 100) */}
      <div className="space-y-1.5">
        <div className="flex items-center justify-between text-xs">
          <span className="font-medium text-slate-600">Lead Score</span>
          <span className="font-bold text-slate-900">{clampedScore} / 100</span>
        </div>
        <div className="h-2.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div
            className={`h-full transition-all duration-300 ${style.bar}`}
            style={{ width: `${clampedScore}%` }}
          />
        </div>
      </div>

      {/* Summary & Next Step */}
      <div className="space-y-3 rounded-lg bg-slate-50 p-3.5 text-sm">
        <div>
          <p className="text-xs font-semibold text-slate-500">Summary</p>
          <p className="mt-0.5 text-slate-800">{lead.summary}</p>
        </div>
        <div className="border-t border-slate-200 pt-2.5">
          <p className="text-xs font-semibold text-slate-500">Recommended Next Step</p>
          <p className="mt-0.5 font-medium text-indigo-700">{lead.next_step}</p>
        </div>
      </div>

      <div className="flex items-center justify-between pt-1">
        <span className="text-xs text-slate-500">
          Budget: <strong className="text-slate-700">{lead.budget || "—"}</strong> ·
          Timeline: <strong className="text-slate-700">{lead.timeline || "—"}</strong>
        </span>

        {onOpenDrawer && (
          <button
            type="button"
            onClick={() => onOpenDrawer(lead.id)}
            className="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
          >
            Inspect Follow-Up
          </button>
        )}
      </div>
    </div>
  );
}
