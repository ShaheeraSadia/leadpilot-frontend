export type LeadTier = "hot" | "warm" | "cold";
export type LeadStatus = "new" | "contacted" | "won" | "lost";

export interface Lead {
  id: number;
  source: "form" | string;
  name: string;
  email: string;
  company: string;
  need: string;
  budget: string;
  timeline: string;
  score: number; // 0 to 100
  tier: LeadTier;
  summary: string;
  next_step: string;
  email_subject: string;
  email_body: string;
  status: LeadStatus;
  qualified: number;
  created: number; // Unix timestamp in seconds
  updated: number; // Unix timestamp in seconds
}

export interface LeadStats {
  total: number;
  hot: number;
  warm: number;
  cold: number;
  new: number;
  won: number;
}

export interface LeadMessage {
  role: "user" | "assistant" | string;
  content: string;
  ts: number;
}

export interface LeadDetailResponse {
  id: number;
  name: string;
  email_subject: string;
  email_body: string;
  status: LeadStatus;
  messages: LeadMessage[];
}

// Form fields that map to backend payload
export interface IntakeFormValues {
  fullName: string;
  email: string;
  phone: string;
  company: string;
  serviceNeeded: string;
  projectNotes: string;
  monthlyBudget: string;
  timeline: string;
}

export const API_BASE_URL = "http://127.0.0.1:8002";

export function mapFormToLeadPayload(values: IntakeFormValues) {
  const combinedMessage = [values.serviceNeeded.trim(), values.projectNotes.trim()]
    .filter(Boolean)
    .join(" — ");

  return {
    name: values.fullName.trim(),
    email: values.email.trim(),
    phone: values.phone.trim(),
    company: values.company.trim(),
    message: combinedMessage,
    budget: values.monthlyBudget.trim(),
    timeline: values.timeline.trim(),
    source: "form",
  };
}

export function getTierFromScore(score: number): LeadTier {
  if (score >= 70) return "hot";
  if (score >= 40) return "warm";
  return "cold";
}

