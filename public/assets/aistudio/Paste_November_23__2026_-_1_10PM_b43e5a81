}
5. Follow-Up Status Drawer (components/FollowUpDrawer.tsx)
Is mein email_subject, email_body, demo status mapping (new = "Draft Ready", contacted = "Follow-Up Sent", plus won / lost via PATCH /api/leads/{id}), aur POST /api/leads/{id}/requalify button shamil hain.

TypeScript
"use client";

import React, { useState } from "react";
import { API_BASE_URL, Lead, LeadStatus } from "@/types/lead";

interface FollowUpDrawerProps {
  lead: Lead | null;
  onClose: () => void;
  onLeadUpdated: (updated: Lead) => void;
  useMockFallback?: boolean;
}

const DEMO_STATUS_LABELS: Record<LeadStatus, string> = {
  new: "Draft Ready",
  contacted: "Follow-Up Sent",
  won: "Won",
  lost: "Lost",
};

export default function FollowUpDrawer({
  lead,
  onClose,
  onLeadUpdated,
  useMockFallback = false,
}: FollowUpDrawerProps) {
  const [isUpdatingStatus, setIsUpdatingStatus] = useState(false);
  const [isRequalifying, setIsRequalifying] = useState(false);
  const [actionMessage, setActionMessage] = useState<string | null>(null);

  if (!lead) return null;

  const handleStatusUpdate = async (nextStatus: LeadStatus) => {
    setIsUpdatingStatus(true);
    setActionMessage(null);
    try {
      if (useMockFallback) {
        const updated: Lead = {
          ...lead,
          status: nextStatus,
          updated: Math.floor(Date.now() / 1000),
        };
        onLeadUpdated(updated);
        setActionMessage(`Status set to "${DEMO_STATUS_LABELS[nextStatus]}".`);
        return;
      }

      const res = await fetch(`${API_BASE_URL}/api/leads/${lead.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: nextStatus }),
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setActionMessage(data?.detail || "Failed to update status.");
        return;
      }

      onLeadUpdated(data as Lead);
      setActionMessage(`Status updated to "${DEMO_STATUS_LABELS[nextStatus]}".`);
    } catch {
      setActionMessage("Network error while updating status.");
    } finally {
      setIsUpdatingStatus(false);
    }
  };

  const handleRequalify = async () => {
    setIsRequalifying(true);
    setActionMessage(null);
    try {
      if (useMockFallback) {
        await new Promise((r) => setTimeout(r, 800));
        const bumpedScore = Math.min(100, lead.score + 5);
        const updated: Lead = {
          ...lead,
          score: bumpedScore,
          updated: Math.floor(Date.now() / 1000),
        };
        onLeadUpdated(updated);
        setActionMessage("Lead re-qualified with AI.");
        return;
      }

      const res = await fetch(`${API_BASE_URL}/api/leads/${lead.id}/requalify`, {
        method: "POST",
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        setActionMessage(data?.detail || "Re-qualification failed (check AI service).");
        return;
      }

      onLeadUpdated(data as Lead);
      setActionMessage("Lead re-qualified successfully.");
    } catch {
      setActionMessage("Network error while re-qualifying.");
    } finally {
      setIsRequalifying(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex justify-end bg-slate-900/40 backdrop-blur-[1px]">
      <div className="h-full w-full max-w-lg overflow-y-auto bg-white p-6 shadow-2xl space-y-5">
        <div className="flex items-start justify-between border-b border-slate-200 pb-4">
          <div>
            <p className="text-xs font-medium text-indigo-600">Follow-Up Drawer</p>
            <h3 className="text-xl font-semibold text-slate-900">{lead.name}</h3>
            <p className="text-xs text-slate-500">
              {lead.email} {lead.company ? `· ${lead.company}` : ""}
            </p>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50"
          >
            Close
          </button>
        </div>

        {/* Demo Follow-Up State */}
        <div className="rounded-lg bg-slate-50 p-3.5 space-y-2">
          <div className="flex items-center justify-between text-xs">
            <span className="font-semibold text-slate-600">Current Pipeline Status</span>
            <span className="rounded-full bg-indigo-100 px-2.5 py-0.5 font-semibold text-indigo-800">
              {DEMO_STATUS_LABELS[lead.status]} ({lead.status})
            </span>
          </div>
          <div className="flex flex-wrap gap-2 pt-1">
            {(["new", "contacted", "won", "lost"] as LeadStatus[]).map((st) => (
              <button
                key={st}
                type="button"
                disabled={isUpdatingStatus || lead.status === st}
                onClick={() => handleStatusUpdate(st)}
                className="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50"
              >
                Mark {DEMO_STATUS_LABELS[st]}
              </button>
            ))}
          </div>
        </div>

        {/* AI Follow-Up Email Draft */}
        <div className="space-y-2">
          <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">
            AI Follow-Up Draft
          </p>
          <div className="rounded-lg border border-slate-200 p-3.5 space-y-2 text-sm">
            <div>
              <span className="text-xs font-medium text-slate-400">Subject:</span>
              <p className="font-medium text-slate-900">
                {lead.email_subject || "No subject generated"}
              </p>
            </div>
            <div className="border-t border-slate-100 pt-2">
              <span className="text-xs font-medium text-slate-400">Body:</span>
              <p className="whitespace-pre-line text-slate-700">
                {lead.email_body || "No draft body generated"}
              </p>
            </div>
          </div>
        </div>

        {actionMessage && (
          <div className="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-800">
            {actionMessage}
          </div>
        )}

        {/* Requalify Action */}
        <div className="border-t border-slate-200 pt-4 flex items-center justify-between">
          <span className="text-xs text-slate-500">
            Score: <strong className="text-slate-800">{lead.score}/100</strong> ({lead.tier})
          </span>
          <button
            type="button"
            onClick={handleRequalify}
            disabled={isRequalifying}
            className="rounded-lg bg-slate-900 px-3.5 py-2 text-xs font-medium text-white hover:bg-slate-800 disabled:opacity-60"
          >
            {isRequalifying ? "Re-qualifying..." : "Re-qualify Lead"}
          </button>
        </div>
      </div>
    </div>
  );
}
