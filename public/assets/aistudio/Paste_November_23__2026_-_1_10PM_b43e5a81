"use client";

import React, { useMemo, useState } from "react";
import { Lead, LeadStats, LeadTier } from "@/types/lead";

interface PipelineTableProps {
  leads: Lead[];
  stats: LeadStats;
  activeTier: "all" | LeadTier;
  onTierChange: (tier: "all" | LeadTier) => void;
  onSelectLead: (lead: Lead) => void;
  isLoading?: boolean;
}

export default function PipelineTable({
  leads,
  stats,
  activeTier,
  onTierChange,
  onSelectLead,
  isLoading = false,
}: PipelineTableProps) {
  const [searchQuery, setSearchQuery] = useState("");

  // Client-side search by name or company as specified
  const filteredLeads = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    return leads.filter((item) => {
      const matchesTier = activeTier === "all" || item.tier === activeTier;
      const matchesQuery =
        !q ||
        item.name.toLowerCase().includes(q) ||
        item.company.toLowerCase().includes(q);
      return matchesTier && matchesQuery;
    });
  }, [leads, activeTier, searchQuery]);

  return (
    <div className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
      {/* Header Stats Badges */}
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 className="text-lg font-semibold text-slate-900">Leads Pipeline</h2>
          <p className="text-xs text-slate-500">
            Click any row to open the follow-up drawer and update status.
