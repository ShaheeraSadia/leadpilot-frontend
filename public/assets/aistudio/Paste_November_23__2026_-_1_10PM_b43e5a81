          placeholder="Search by name or company..."
          className="w-full sm:w-64 rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none"
        />
      </div>

      {/* Table */}
